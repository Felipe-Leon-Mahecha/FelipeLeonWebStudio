---
import DemoStrip from './DemoStrip.astro';
import DemoHeader from './DemoHeader.astro';
import DemoHero from './DemoHero.astro';
import DemoFooter from './DemoFooter.astro';
import DemoPersonalizePanel from './DemoPersonalizePanel.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { whatsappLink } from '../../lib/site';
import { Icon } from 'astro-icon/components';

const accent = '#2f9e44';
const tier = "normal";
const base = '#fbf7ec';
const surface = '#fffdf6';
const accentOptions = ['#198754', '#fd7e14', '#e03131', '#f59f00', '#7048e8'];

const products = [
  { icon: 'lucide:shopping-basket', name: 'Mercado de la semana', price: '$45.000', desc: '10 productos: frutas, verduras, granos y proteína.', hot: true },
  { icon: 'lucide:egg', name: 'Huevos (x30)', price: '$12.500', desc: 'Huevos de granja, tamaño real.' },
  { icon: 'lucide:carrot', name: 'Verduras de temporada', price: '$4.800', desc: 'Precio por kilo, todo del día.' },
  { icon: 'lucide:apple', name: 'Fruta fresca (canasta)', price: '$15.000', desc: 'Canasta surtida de 3 kilos.' },
  { icon: 'lucide:coffee', name: 'Café molido 500 g', price: '$18.000', desc: 'Tostión media, café de origen.' },
  { icon: 'lucide:wheat', name: 'Arroz 5 kg', price: '$28.000', desc: 'Arroz blanco de grano largo.' },
];

const route = [
  ['Lunes', 'Belén'],
  ['Martes', 'Laureles'],
  ['Miércoles', 'El Poblado'],
  ['Jueves', 'La América'],
  ['Viernes', 'Manrique'],
  ['Sábado', 'Envigado · Plaza'],
  ['Domingo', 'Descanso'],
];

const steps = [
  { n: '01', title: 'Mira la ruta del día', desc: 'Sabemos dónde está la camioneta hoy y a qué hora.' },
  { n: '02', title: 'Elige tus productos', desc: 'Arma tu mercado del catálogo o pide el combo de la semana.' },
  { n: '03', title: 'Pide por WhatsApp', desc: 'Envías tu lista y te confirmamos precio y disponibilidad.' },
  { n: '04', title: 'Recoge o recibe en casa', desc: 'Pásala por la camioneta o te la dejamos en la puerta.' },
];

const testimonials = [
  { text: 'El mercado llegó puntual y todo fresquito. Se nota que les importa.', name: 'Doña Rosa', tag: 'Belén' },
  { text: 'Pido los viernes y llega en 40 minutos. Un salvavidas de la semana.', name: 'Andrés M.', tag: 'Manrique' },
  { text: 'Precios mejores que la tienda del barrio y todo bien presentado.', name: 'Carolina S.', tag: 'Laureles' },
];

const wa = whatsappLink('Hola, quiero hacer un pedido del Mercado Rodante. ¿Cuál es la ruta de hoy?');
---

<DemoStrip slug="mercados" brand="Mercado Rodante" tier={tier} />
<DemoHeader
  brand="Mercado Rodante"
  accent={accent}
  links={[
    { label: 'Catálogo', href: '#catalogo' },
    { label: 'Ruta', href: '#ruta' },
    { label: 'Cómo pedir', href: '#como-funciona' },
    { label: 'Horarios', href: '#horarios' },
  ]}
  ctaText="Pedir hoy"
  ctaHref={wa}
  light
  editableBrand
  showLogoPlaceholder={true}
/>

<main style={`background:${base}`}>
  <DemoHero
    badge="Hoy en tu barrio · Belén"
    titleA="Tu mercado de confianza,"
    titleB="hoy en tu cuadra."
    tagline="La camioneta del mercado llega con frutas, verduras, granos y domicilios. Pide hoy por WhatsApp y recoge o recibe en casa."
    accent={accent}
    palette={['#fbf7ec', '#dcead3']}
    ctaText="Pedir hoy"
    ctaHref={wa}
    secondaryText="Ver catálogo"
    secondaryHref="#catalogo"
    meta={['Domicilios gratis', 'Precios justos', 'Pago al recibir']}
    editableTitle
  />

  <section id="catalogo" class="py-24">
    <div class="shell">
      <div class="max-w-2xl">
        <span class="font-mono text-xs font-medium tracking-[0.25em] uppercase" style={`color:${accent}`}>
          Catálogo destacado
        </span>
        <h2 class="display mt-3 text-3xl text-[#141414] sm:text-5xl">Lo más pedido de la semana</h2>
      </div>

      <div
        class="mt-10 overflow-hidden rounded-2xl border border-[#141414]/10"
        style="box-shadow:var(--shadow-card)"
      >
        <img
          src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1600&q=80"
          alt="Canastas de frutas y verduras frescas en el mercado"
          loading="lazy"
          class="h-56 w-full object-cover sm:h-72 lg:h-80"
        />
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <div
            class="group relative flex flex-col rounded-2xl border border-[#141414]/10 p-7 shadow-[0_8px_30px_rgba(47,158,68,0.05)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(47,158,68,0.12)]"
            style={`background:${surface}`}
          >
            {p.hot && (
              <span
                class="absolute -top-3 right-5 rounded-full px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-white"
                style={`background:${accent}`}
              >
                Combo del día
              </span>
            )}
            <Icon
              name={p.icon}
              width={28}
              height={28}
              class="h-7 w-7 transition-transform duration-300 group-hover:scale-110"
              style={`color:${accent}`}
            />
            <h3 class="mt-5 font-display text-xl font-bold text-[#141414]">{p.name}</h3>
            <p class="mt-1.5 flex-1 text-sm text-[#141414]/60">{p.desc}</p>
            <p class="mt-5 font-mono text-lg font-semibold" style={`color:${accent}`}>
              {p.price}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="ruta" class="pb-24">
    <div class="shell">
      <div class="max-w-2xl">
        <span class="font-mono text-xs font-medium tracking-[0.25em] uppercase" style={`color:${accent}`}>
          Ruta semanal
        </span>
        <h2 class="display mt-3 text-3xl text-[#141414] sm:text-5xl">Hoy y toda la semana</h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {route.map(([d, zone], i) => (
          <div
            class={`flex items-center justify-between rounded-2xl border p-5 ${i === 0 ? 'border-transparent text-white' : 'border-[#141414]/10'}`}
            style={i === 0 ? `background:${accent}` : `background:${surface}`}
          >
            <div>
              <p class={`font-mono text-xs tracking-widest uppercase ${i === 0 ? 'text-white/70' : 'text-[#141414]/45'}`}>
                {d}
              </p>
              <p class={`mt-1 font-display text-lg font-bold ${i === 0 ? 'text-white' : 'text-[#141414]'}`}>
                {zone}
              </p>
            </div>
            {i === 0 && (
              <span class="rounded-full bg-white px-3 py-1 font-mono text-[11px] font-semibold uppercase" style={`color:${accent}`}>
                Hoy
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="como-funciona" class="pb-24">
    <div class="shell">
      <div class="max-w-2xl">
        <span class="font-mono text-xs font-medium tracking-[0.25em] uppercase" style={`color:${accent}`}>
          Cómo funciona
        </span>
        <h2 class="display mt-3 text-3xl text-[#141414] sm:text-5xl">Pedir nunca fue tan fácil</h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s) => (
          <div class="rounded-2xl border border-[#141414]/10 p-7" style={`background:${surface}`}>
            <span class="font-display text-4xl font-bold" style={`color:${accent}`}>{s.n}</span>
            <h3 class="mt-4 font-display text-lg font-bold text-[#141414]">{s.title}</h3>
            <p class="mt-2 text-sm text-[#141414]/60">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="testimonios" class="pb-24">
    <div class="shell">
      <div class="max-w-2xl">
        <span class="font-mono text-xs font-medium tracking-[0.25em] uppercase" style={`color:${accent}`}>
          El barrio habla
        </span>
        <h2 class="display mt-3 text-3xl text-[#141414] sm:text-5xl">Vecinos que ya confían</h2>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {testimonials.map((t) => (
          <div class="flex flex-col rounded-2xl border border-[#141414]/10 p-7" style={`background:${surface}`}>
            <div class="flex gap-1">
              {[0, 1, 2, 3, 4].map(() => (
                <Icon name="lucide:star" width={16} height={16} class="h-4 w-4 fill-current" style={`color:${accent}`} />
              ))}
            </div>
            <p class="mt-5 flex-1 leading-relaxed text-[#141414]/75">“{t.text}”</p>
            <p class="mt-6">
              <span class="font-display font-bold text-[#141414]">{t.name}</span>
              <span class="mt-0.5 block text-sm text-[#141414]/50">{t.tag}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="pb-24">
    <div class="shell max-w-3xl">
      <div class="text-center">
        <span class="font-mono text-xs font-medium tracking-[0.25em] uppercase" style={`color:${accent}`}>
          Preguntas frecuentes
        </span>
        <h2 class="display mt-4 text-3xl text-[#141414] sm:text-4xl lg:text-5xl">Dudas de la ruta</h2>
        <p class="mt-5 leading-relaxed text-[#141414]/65">
          Si tu pregunta no está, escribe por WhatsApp y te respondemos rápido.
        </p>
      </div>
      <div class="mt-12 space-y-3">
        {[
          {
            q: '¿Cómo sé a qué hora llega la camioneta a mi barrio?',
            a: 'Publicamos la ruta del día temprano por WhatsApp. Cuando haces tu pedido te confirmamos la hora exacta de llegada y el punto exacto. Cada parada dura entre 1 y 2 horas.',
          },
          {
            q: '¿Puedo pedir domicilio si el día no toca en mi barrio?',
            a: 'Sí. Tenemos domicilio en gran parte de la ciudad sin importar la ruta del día. Si tu zona no está cubierta, pasamos por un punto cercano que nos digas.',
          },
          {
            q: '¿Qué pasa si un producto no está disponible?',
            a: 'Te avisamos por WhatsApp antes de armar tu pedido. Te ofrecemos un sustituto igual o mejor, o te quitamos el producto del total. Tu pagas sólo por lo que recibes.',
          },
          {
            q: '¿Aceptan pagos por Nequi o Daviplata?',
            a: 'Claro. Aceptamos efectivo, Nequi, Daviplata y transferencia bancaria. Pagas cuando recibes tu pedido en la camioneta o te llega a domicilio.',
          },
        ].map((f, i) => (
          <div class="card overflow-hidden" style={`background:${surface}`}>
            <h3>
              <button
                type="button"
                data-faq-trigger
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`mercados-faq-panel-${i}`}
                id={`mercados-faq-trigger-${i}`}
                class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left"
              >
                <span class="font-display text-base font-bold text-[#141414] sm:text-lg">{f.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  width={20}
                  height={20}
                  class={`faq-chevron h-5 w-5 shrink-0 transition-transform duration-300 ${i === 0 ? 'rotate-180' : ''}`}
                  style={`color:${accent}`}
                />
              </button>
            </h3>
            <div
              id={`mercados-faq-panel-${i}`}
              role="region"
              aria-labelledby={`mercados-faq-trigger-${i}`}
              class={`faq-panel ${i === 0 ? 'open' : ''}`}
            >
              <div class="px-6 pb-6">
                <p class="text-sm leading-relaxed text-[#141414]/65">{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="horarios" class="pb-24">
    <div class="shell grid gap-5 lg:grid-cols-2">
      <div class="rounded-2xl border border-[#141414]/10 p-8" style={`background:${surface}`}>
        <div class="flex items-center gap-3">
          <Icon name="lucide:clock" width={24} height={24} class="h-6 w-6" style={`color:${accent}`} />
          <h3 class="font-display text-2xl font-bold text-[#141414]">Horarios por zona</h3>
        </div>
        <ul class="mt-6 space-y-3">
          {route.map(([d, zone]) => (
            <li class="flex items-center justify-between border-b border-[#141414]/5 pb-3 text-sm">
              <span class="text-[#141414]/60">{d}</span>
              <span class="font-mono text-[#141414]">{zone}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-[#141414]/50">Cada parada dura entre 1 y 2 horas. Confirma la hora exacta por WhatsApp.</p>
      </div>

      <div class="flex flex-col justify-between rounded-2xl border border-[#141414]/10 p-8" style={`background:${surface}`}>
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-3">
            <Icon name="lucide:truck" width={24} height={24} class="h-6 w-6" style={`color:${accent}`} />
            <h3 class="font-display text-2xl font-bold text-[#141414]">Hoy en Belén</h3>
          </div>
          <div class="overflow-hidden rounded-2xl border border-[#141414]/10">
            <iframe
              title="Mapa de ubicación Mercado Rodante"
              src="https://www.google.com/maps?q=Carrera+76+con+Calle+30,+Bel%C3%A9n,+Medell%C3%ADn&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="h-56 w-full sm:h-64"
            ></iframe>
          </div>
          <p class="text-[#141414]/60">
            Parquedos sobre la Cra 76 con Calle 30, frente al parque.
            <br />
            Atención de 8:00 am a 5:00 pm, o hasta agotar mercado.
          </p>
        </div>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 font-semibold text-white transition-transform hover:-translate-y-0.5"
          style={`background:${accent}`}
        >
          <WhatsAppIcon width={18} height={18} class="h-4.5 w-4.5" />
          Pedir hoy
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var triggers = document.querySelectorAll('[data-faq-trigger]');
      triggers.forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var card = trigger.closest('.card');
          var panel = card ? card.querySelector('.faq-panel') : null;
          var isOpen = trigger.getAttribute('aria-expanded') === 'true';
          triggers.forEach(function (t) {
            t.setAttribute('aria-expanded', 'false');
            var c = t.querySelector('.faq-chevron');
            if (c) c.classList.remove('rotate-180');
            var ca = t.closest('.card');
            var p = ca ? ca.querySelector('.faq-panel') : null;
            if (p) p.classList.remove('open');
          });
          if (!isOpen && panel) {
            trigger.setAttribute('aria-expanded', 'true');
            panel.classList.add('open');
            var ch = trigger.querySelector('.faq-chevron');
            if (ch) ch.classList.add('rotate-180');
          }
        });
      });
    })();
  </script>
</main>

<DemoFooter
  brand="Mercado Rodante"
  accent={accent}
  ctaText="Haz tu pedido hoy"
  message="Hola, quiero hacer un pedido del Mercado Rodante. ¿Cuál es la ruta de hoy?"
/>

<DemoPersonalizePanel accentOptions={accentOptions} defaultAccent={accent} />
