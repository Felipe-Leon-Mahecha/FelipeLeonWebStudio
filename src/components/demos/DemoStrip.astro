---
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { whatsappLink } from '../../lib/site';

interface Props {
  slug: string;
  brand: string;
}

const { slug, brand } = Astro.props;
const wa = whatsappLink(`Hola Felipe, vi la demo de ${brand} y quiero una página así para mi negocio.`);
---

<div class="fixed inset-x-0 top-0 z-50 h-11 border-b border-white/10 bg-[#0a0a0a]">
  <div class="shell flex h-11 items-center justify-between gap-3">
    <span class="flex items-center gap-3 font-mono text-[11px] tracking-widest text-white/55 uppercase">
      <span class="flex gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
      </span>
      <span class="hidden sm:inline">{slug}.demo</span>
    </span>

    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-full bg-[#25d366] px-4 py-1.5 text-xs font-semibold text-[#0a0a0a] transition-transform hover:-translate-y-0.5"
    >
      <WhatsAppIcon width={14} height={14} class="h-3.5 w-3.5" />
      Quiero una página como esta
    </a>
  </div>
</div>
