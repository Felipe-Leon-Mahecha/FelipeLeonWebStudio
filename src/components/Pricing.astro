---
import Reveal from './ui/Reveal.astro';
import Button from './ui/Button.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { whatsappLink } from '../lib/site';
import { Icon } from 'astro-icon/components';

const tiers = [
  {
    name: 'Página Simple',
    price: '500.000',
    tagline: 'Para empezar a vender hoy',
    features: [
      'Diseño a medida, cero plantillas',
      'Una página enfocada en convertir',
      'WhatsApp integrado',
      'Perfecta en el celular',
      'SEO básico',
      '30 días de ajustes incluidos',
    ],
    featured: false,
    cta: 'Cotizar página',
    message: 'Hola Felipe, quiero cotizar una Página Web Simple.',
  },
  {
    name: 'Sitio Completo',
    price: '900.000',
    tagline: 'Para negocios que quieren crecer',
    features: [
      'Todo lo de la Página Simple',
      'Varias secciones a medida',
      'Servicios con precios y galería',
      'SEO y Google Maps',
      'Textos listos para tu negocio',
      'Entrega en 5-7 días',
    ],
    featured: true,
    cta: 'Cotizar sitio',
    message: 'Hola Felipe, quiero cotizar un Sitio Web Completo.',
  },
  {
    name: 'Tienda / Panel',
    price: '1.500.000',
    tagline: 'Para vender sin plataformas caras',
    features: [
      'Todo lo del Sitio Completo',
      'Catálogo de productos',
      'Pedidos directos por WhatsApp',
      'Panel administrativo sencillo',
      'Pasarela de pago integrable',
      'Entrega en 7-10 días',
    ],
    featured: false,
    cta: 'Cotizar tienda',
    message: 'Hola Felipe, quiero cotizar una Tienda Web con panel.',
  },
];
---

<section id="precios" class="bg-paper-soft/50 py-24 dark:bg-ink-soft/50">
  <div class="shell">
    <Reveal class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Precios</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl lg:text-5xl">
        Precios claros, sin letra pequeña
      </h2>
      <p class="mt-5 leading-relaxed text-ink/65 dark:text-paper/65">
        Sabes exactamente cuánto cuesta y qué incluye antes de empezar. Cada proyecto se
        ajusta a tu negocio.
      </p>
    </Reveal>

    <div class="mt-14 grid items-start gap-6 lg:grid-cols-3">
      {
        tiers.map((t, i) => (
          <Reveal
            delay={i * 120}
            class={
              t.featured
                ? 'card relative border-accent-500/50 p-8 shadow-[var(--shadow-glow)] dark:border-accent-400/40 lg:-mt-4 lg:mb-4'
                : 'card relative p-8'
            }
          >
            {
              t.featured && (
                <span
                  class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-accent-500 px-4 py-1.5 font-mono text-xs font-semibold tracking-wider text-white uppercase shadow-[var(--shadow-glow)]"
                >
                  Más elegido
                </span>
              )
            }

            <p class="font-mono text-xs tracking-[0.2em] text-ink/50 uppercase dark:text-paper/50">
              {t.name}
            </p>
            <p class="mt-1 text-sm text-ink/55 dark:text-paper/55">{t.tagline}</p>

            <div class="mt-6 flex items-end gap-1.5">
              <span class="font-mono text-sm text-ink/50 dark:text-paper/50">desde</span>
              <span class="display text-4xl text-ink dark:text-paper">${t.price}</span>
            </div>
            <p class="mt-1 font-mono text-xs text-ink/45 dark:text-paper/45">COP · pago único</p>

            <ul class="mt-7 space-y-3">
              {
                t.features.map((f) => (
                  <li class="flex items-start gap-3 text-sm text-ink/70 dark:text-paper/70">
                    <Icon
                      name="lucide:check"
                      width={16}
                      height={16}
                      class="mt-0.5 h-4 w-4 shrink-0 text-brand-500"
                    />
                    {f}
                  </li>
                ))
              }
            </ul>

            <Button
              href={whatsappLink(t.message)}
              variant={t.featured ? 'primary' : 'secondary'}
              class="mt-8 w-full"
            >
              <WhatsAppIcon width={18} height={18} class="h-4.5 w-4.5" />
              {t.cta}
            </Button>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={120} class="mx-auto mt-10 max-w-2xl text-center">
      <p class="text-sm leading-relaxed text-ink/55 dark:text-paper/55">
        Todos los proyectos incluyen mantenimiento gratuito durante 30 días.{' '}
        <span class="text-ink/75 dark:text-paper/75">
          Plan de mantenimiento mensual desde $150.000
        </span>{' '}
        (hosting + dominio + copias de seguridad + soporte). Hosting y dominio se facturan
        aparte o se incluyen en el plan.
      </p>
    </Reveal>
  </div>
</section>
