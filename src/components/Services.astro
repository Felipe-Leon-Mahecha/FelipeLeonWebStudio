---
import Reveal from './ui/Reveal.astro';
import Button from './ui/Button.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { whatsappLink } from '../lib/site';
import { Icon } from 'astro-icon/components';

const services = [
  {
    icon: 'lucide:target',
    title: 'Landing page',
    text: 'Una página enfocada 100% en convertir visitantes en clientes: tu oferta clara y un botón de WhatsApp siempre a la vista.',
  },
  {
    icon: 'lucide:globe',
    title: 'Sitio corporativo',
    text: 'Tu presencia completa en internet: quién eres, qué ofreces y cómo contactarte. La cara profesional de tu negocio, 24/7.',
  },
  {
    icon: 'lucide:shopping-bag',
    title: 'Catálogo y tienda',
    text: 'Muestra tus productos con fotos y precios. Tus clientes piden directo por WhatsApp, sin plataformas complicadas.',
  },
  {
    icon: 'lucide:calendar-check',
    title: 'Reservas y turnos',
    text: 'Tus clientes agendan citas solos, sin llamadas ni esperas. Perfecto para barberías, consultorios y servicios.',
  },
  {
    icon: 'lucide:message-circle',
    title: 'WhatsApp integrado',
    text: 'Cada web que hago convierte tu teléfono en el centro de tu negocio: preguntas, pedidos y citas en un solo chat.',
  },
  {
    icon: 'lucide:layout-dashboard',
    title: 'Panel administrativo',
    text: 'Edita precios, productos y textos tú mismo, sin saber programar. Tú mandas, yo te acompaño.',
  },
];
---

<section id="servicios" class="relative bg-paper-soft/50 py-24 dark:bg-ink-soft/50">
  <div class="shell">
    <Reveal class="max-w-2xl">
      <p class="eyebrow">Servicios</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl lg:text-5xl">
        Lo que hago por tu negocio
      </h2>
      <p class="mt-5 leading-relaxed text-ink/65 dark:text-paper/65">
        No vendo "páginas web": vendo resultados. Cada servicio está pensado para que tu
        negocio se vea profesional y reciba clientes por WhatsApp.
      </p>
    </Reveal>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s, i) => (
          <Reveal
            delay={(i % 3) * 100}
            class="card group p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent-500/40 hover:shadow-[var(--shadow-glow)]"
          >
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-500 transition-colors duration-300 group-hover:bg-accent-500 group-hover:text-white"
            >
              <Icon name={s.icon} width={22} height={22} class="h-6 w-6" />
            </div>
            <h3 class="mt-5 font-display text-xl font-bold">{s.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink/60 dark:text-paper/60">{s.text}</p>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={150} class="mt-14 flex flex-col items-center gap-4 text-center">
      <p class="text-ink/60 dark:text-paper/60">
        ¿No ves lo que necesitas? Cuéntame tu caso y lo resolvemos juntos.
      </p>
      <Button href={whatsappLink('Hola Felipe, quiero una web para mi negocio. ¿Qué me recomiendas?')}>
        <WhatsAppIcon width={20} height={20} class="h-5 w-5" />
        Hablemos de tu caso
      </Button>
    </Reveal>
  </div>
</section>
