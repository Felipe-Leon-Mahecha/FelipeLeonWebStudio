---
import { SITE, whatsappLink } from '../lib/site';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { Icon } from 'astro-icon/components';

const links = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Portafolio', href: '#portafolio' },
  { label: 'Precios', href: '#precios' },
  { label: 'FAQ', href: '#faq' },
];
---

<footer class="border-t border-line dark:border-line-dark">
  <div class="shell grid gap-12 py-16 md:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      <a href="#inicio" class="flex items-center gap-2.5">
        <img
          src="/logo.png"
          alt=""
          width={32}
          height={32}
          class="h-8 w-8 rounded-md object-contain"
        />
        <span class="font-display font-bold tracking-tight">Felipe León</span>
        <span class="font-mono text-xs font-medium tracking-[0.2em] text-ink/45 uppercase dark:text-paper/45">web studio</span>
      </a>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink/60 dark:text-paper/60">
        {SITE.description}
      </p>
    </div>

    <nav aria-label="Pie de página">
      <h3 class="font-mono text-xs font-medium tracking-[0.25em] text-ink/45 uppercase dark:text-paper/45">
        Navegación
      </h3>
      <ul class="mt-4 space-y-2.5">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm text-ink/70 transition-colors hover:text-accent-600 dark:text-paper/70 dark:hover:text-accent-300"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h3 class="font-mono text-xs font-medium tracking-[0.25em] text-ink/45 uppercase dark:text-paper/45">
        Contacto
      </h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a
            href={whatsappLink('Hola Felipe, quiero una web para mi negocio.')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-ink/70 transition-colors hover:text-brand-600 dark:text-paper/70 dark:hover:text-brand-400"
          >
            <WhatsAppIcon width={16} height={16} class="h-4 w-4" />
            WhatsApp directo
          </a>
        </li>
        <li>
          <a
            href={`mailto:${SITE.email}`}
            class="text-ink/70 transition-colors hover:text-accent-600 dark:text-paper/70 dark:hover:text-accent-300"
          >
            {SITE.email}
          </a>
        </li>
        <li>
          <a
            href={`https://instagram.com/${SITE.instagram}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-ink/70 transition-colors hover:text-accent-600 dark:text-paper/70 dark:hover:text-accent-300"
          >
            <Icon name="lucide:instagram" width={16} height={16} class="h-4 w-4" />
            @{SITE.instagram}
          </a>
        </li>
        <li class="text-ink/50 dark:text-paper/50">{SITE.location}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line dark:border-line-dark">
    <div class="shell flex flex-col items-start justify-between gap-3 py-6 text-xs text-ink/50 dark:text-paper/50 sm:flex-row sm:items-center">
      <p>© {new Date().getFullYear()} {SITE.name}. Todos los derechos reservados.</p>
      <p class="font-mono tracking-wide">Hecho a mano con código — sin plantillas.</p>
    </div>
  </div>
</footer>
