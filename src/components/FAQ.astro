---
import Reveal from './ui/Reveal.astro';
import Button from './ui/Button.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { whatsappLink } from '../lib/site';
import { Icon } from 'astro-icon/components';

const faqs = [
  {
    q: '¿Cuánto cuesta una página web?',
    a: 'Una página simple va desde $500.000 COP, un sitio completo desde $900.000 y una tienda con panel desde $1.500.000. Te doy un precio exacto y cerrado antes de empezar, sin costos ocultos.',
  },
  {
    q: '¿Cuánto tarda en estar lista?',
    a: 'Una landing page en 5-7 días. Un sitio completo en 2-3 semanas. La mayoría de agencias tardan meses; mi proceso con IA me permite entregar calidad premium mucho más rápido.',
  },
  {
    q: '¿Necesito saber de tecnología?',
    a: 'No. Yo me encargo de todo: diseño, desarrollo, publicación. Tú solo me cuentas qué hace tu negocio y qué quieres lograr. Te mantengo al tanto por WhatsApp en cada paso.',
  },
  {
    q: '¿Y si no me gusta el diseño?',
    a: 'Trabajamos juntos hasta que te guste. El primer diseño lo revisamos contigo y tienes rondas de ajustes incluidas. No publico nada hasta que lo apruebes tú.',
  },
  {
    q: '¿Puedo actualizar el contenido yo mismo?',
    a: 'Sí. Con el plan de mantenimiento edito los cambios por ti, y en proyectos con panel administrativo puedes modificar precios y productos tú mismo sin saber programar.',
  },
  {
    q: '¿Qué incluye y qué no incluye el precio?',
    a: 'Incluye diseño a medida, desarrollo, WhatsApp integrado, SEO básico, versión móvil y 30 días de ajustes. No incluye hosting ni dominio (se facturan aparte o entran en el plan mensual).',
  },
];
---

<section id="faq" class="py-24">
  <div class="shell max-w-3xl">
    <Reveal class="text-center">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 class="display mt-4 text-3xl sm:text-4xl lg:text-5xl">
        Resolvamos tus dudas
      </h2>
      <p class="mt-5 leading-relaxed text-ink/65 dark:text-paper/65">
        Si tu pregunta no está aquí, escríbeme directo por WhatsApp.
      </p>
    </Reveal>

    <div class="mt-12 space-y-3">
      {
        faqs.map((f, i) => (
          <Reveal
            delay={i * 60}
            class="card overflow-hidden"
          >
            <h3>
              <button
                type="button"
                data-faq-trigger
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`faq-panel-${i}`}
                id={`faq-trigger-${i}`}
                class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left"
              >
                <span class="font-display text-base font-bold sm:text-lg">{f.q}</span>
                <Icon
                  name="lucide:chevron-down"
                  width={20}
                  height={20}
                  class={`faq-chevron h-5 w-5 shrink-0 text-accent-500 transition-transform duration-300 ${
                    i === 0 ? 'rotate-180' : ''
                  }`}
                />
              </button>
            </h3>
            <div
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-trigger-${i}`}
              class={`faq-panel ${i === 0 ? 'open' : ''}`}
            >
              <div class="px-6 pb-6">
                <p class="text-sm leading-relaxed text-ink/65 dark:text-paper/65">{f.a}</p>
              </div>
            </div>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={100} class="mt-12 flex justify-center">
      <Button variant="secondary" href={whatsappLink('Hola Felipe, tengo una pregunta sobre tu trabajo.')}>
        <WhatsAppIcon width={18} height={18} class="h-4.5 w-4.5" />
        Preguntar directo
      </Button>
    </Reveal>
  </div>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const panel = trigger
        .closest('.card')
        ?.querySelector<HTMLElement>('[data-faq-panel]') as HTMLElement | null;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      triggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'false');
        t.querySelector('.faq-chevron')?.classList.remove('rotate-180');
        t.closest('.card')?.querySelector('.faq-panel')?.classList.remove('open');
      });

      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        panel?.classList.add('open');
        trigger.querySelector('.faq-chevron')?.classList.add('rotate-180');
      }
    });
  });
</script>
